---
interface Props {
  title?: string;
  prompt?: string;
}

const { title = 'ターミナル', prompt = 'LOCAL' } = Astro.props;
---

<section class="command-panel">
  <div class="command-panel__bar">
    <div class="command-panel__dots" aria-hidden="true"><i></i><i></i><i></i></div>
    <span>{title}</span>
    <small>{prompt}</small>
  </div>
  <div class="command-panel__body"><slot /></div>
</section>

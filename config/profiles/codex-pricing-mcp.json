{
  "schema_version": "1.0",
  "name": "codex-aws-pricing-mcp",
  "kind": "command",
  "command": [
    "codex",
    "exec",
    "--ephemeral",
    "--json",
    "--output-schema",
    "{schema_file}",
    "--output-last-message",
    "{output_file}",
    "-"
  ],
  "parser": "output-file-json",
  "timeout_seconds": 900,
  "environment": {
    "FASTMCP_LOG_LEVEL": "ERROR",
    "AWS_PRICING_MCP_OUTPUT_DIR": "{workspace}"
  },
  "required_commands": [
    "codex",
    "uvx"
  ],
  "required_environment": [
    "AWS_PROFILE",
    "AWS_REGION"
  ]
}

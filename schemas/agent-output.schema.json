{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/agent-output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "case_id", "status", "region", "currency",
    "price_effective_at", "monthly_total_usd", "service_estimates",
    "assumptions", "excluded_costs", "missing_inputs", "confidence", "summary"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["completed", "needs_clarification", "unsupported", "error"]},
    "region": {"type": "string", "minLength": 1},
    "currency": {"const": "USD"},
    "price_effective_at": {"type": ["string", "null"], "format": "date"},
    "monthly_total_usd": {"type": ["number", "null"], "minimum": 0},
    "service_estimates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "resource_ids", "monthly_cost_usd", "formula", "pricing_dimensions", "sources"],
        "properties": {
          "service": {"type": "string", "minLength": 1},
          "resource_ids": {"type": "array", "items": {"type": "string"}},
          "monthly_cost_usd": {"type": "number", "minimum": 0},
          "formula": {"type": "string", "minLength": 1},
          "pricing_dimensions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "quantity", "unit", "unit_price_usd"],
              "properties": {
                "name": {"type": "string"},
                "quantity": {"type": "number", "minimum": 0},
                "unit": {"type": "string"},
                "unit_price_usd": {"type": "number", "minimum": 0}
              }
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "url", "retrieved_at"],
              "properties": {
                "title": {"type": "string", "minLength": 1},
                "url": {"type": "string", "format": "uri"},
                "retrieved_at": {"type": "string", "format": "date-time"}
              }
            }
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "statement", "impact"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "impact": {"enum": ["low", "medium", "high"]}
        }
      }
    },
    "excluded_costs": {"type": "array", "items": {"type": "string"}},
    "missing_inputs": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "question"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1}
        }
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "summary": {"type": "string", "minLength": 1},
    "agent_metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {"type": "string"},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "model_cost_usd": {"type": "number", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0}
      }
    }
  }
}

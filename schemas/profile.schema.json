{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "kind", "command", "parser", "timeout_seconds", "environment", "required_commands", "required_environment"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "name": {"type": "string", "minLength": 1},
    "kind": {"const": "command"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "parser": {"enum": ["output-file-json", "stdout-json", "claude-json"]},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "environment": {"type": "object", "additionalProperties": {"type": "string"}},
    "required_commands": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "required_environment": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  }
}
